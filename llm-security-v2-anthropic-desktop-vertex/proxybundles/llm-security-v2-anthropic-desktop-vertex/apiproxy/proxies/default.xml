<ProxyEndpoint name="default">
    <Description/>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>CORS</Name>
            </Step>
            <Step>
                <Name>VA-Key</Name>
                <Condition>request.verb != "HEAD"</Condition>
            </Step>
            <Step>
                <Name>OAS-Verify</Name>
                <Condition>request.verb != "HEAD"</Condition>
            </Step>
            <Step>
                <Name>EV-ExtractFields</Name>
                <Condition>request.verb != "HEAD"</Condition>
            </Step>
            <Step>
                <Name>AM-ExtractRequestPrompt</Name>
                <Condition>request.verb != "HEAD"</Condition>
            </Step>
            <Step>
                <Name>FC-SanitizeUserPrompt</Name>
                <Condition>request.verb != "HEAD"</Condition>
            </Step>
            <Step>
                <Name>JS-TranslateDesktopRequest</Name>
                <Condition>request.verb != "HEAD"</Condition>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows/>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step>
                <Name>AM-HEADResponse</Name>
                <Condition>request.verb == "HEAD"</Condition>
            </Step>
        </Response>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/v1/desktop-vertex</BasePath>
        <Properties>
            <Property name="response.streaming.enabled">true</Property>
        </Properties>
    </HTTPProxyConnection>
    <RouteRule name="NoTargetRoute">
        <!-- Immediately return a successful blank body response on HTTP HEAD requests, or non-messages API discovery paths -->
        <Condition>(request.verb == "HEAD") or Not (proxy.pathsuffix MatchesPath "/v1/projects/*/locations/*/v1/messages")</Condition>
    </RouteRule>
    <RouteRule name="llm">
        <TargetEndpoint>llm</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
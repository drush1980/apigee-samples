<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-HEADResponse">
  <DisplayName>AM-HEADResponse</DisplayName>
  <Properties/>
  <Set>
    <Headers>
      <Header name="Access-Control-Allow-Origin">*</Header>
      <Header name="Access-Control-Allow-Methods">GET, POST, HEAD, OPTIONS</Header>
      <Header name="Access-Control-Allow-Headers">content-type, x-api-key, authorization, accept</Header>
      <Header name="Connection">keep-alive</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
